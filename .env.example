# Which provider to use: "openai" or "groq"
LLM_PROVIDER=groq

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Groq — free tier, open-source models (used when LLM_PROVIDER=groq)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Local embedding model — used when LLM_PROVIDER=groq. Runs on CPU, $0 cost.
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Google OAuth files
GOOGLE_TOKEN_FILE=credentials/token.json

# Hiring workflow
GOOGLE_DRIVE_FOLDER_ID=
DEFAULT_SCORE_THRESHOLD=70
CHECK_INTERVAL_SECONDS=180
TIMEZONE=Asia/Kolkata

# Company/email details
COMPANY_NAME=Your Company
COMPANY_WEBSITE=https://example.com
HR_NAME=Recruiting Team
HR_TITLE=Talent Acquisition
INTERVIEW_MODE=Google Meet
INTERVIEW_DURATION_MIN=45
